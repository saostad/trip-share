rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/{allPaths=**} {
      // Allow read/write for authenticated users
      // Storage rules can't easily check Firestore trip membership,
      // so we rely on the path structure and auth check.
      // Files are stored under trips/{tripId}/... which is only known to trip members.
      allow read, write: if request.auth != null;
    }
  }
}
