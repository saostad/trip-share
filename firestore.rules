rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App-wide settings (invite-only / public switch + allow list).
    // Read: any signed-in user (needed to check create permission).
    // Write: Firebase Console / Admin SDK only — not from the client.
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/appConfig/access);
    }

    // Anyone may sign in and join via share link.
    // Creating trips is restricted when mode == "invite_only".
    // Store allowedEmails in lowercase to match Google token emails.
    function canCreateTrip() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/appConfig/access) ||
        accessDoc().data.mode != "invite_only" ||
        request.auth.token.email in accessDoc().data.allowedEmails
      );
    }

    match /trips/{tripId} {
      // Get (single doc by ID): owner or collaborator
      allow get: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.collaboratorIds
      );

      // List (collection queries): authenticated users
      // The client filters by ownerId or collaboratorIds or shareToken
      allow list: if request.auth != null;

      // Create: ownerId must match; invite_only respects allow list
      allow create: if canCreateTrip() &&
        request.resource.data.ownerId == request.auth.uid;

      // Update: owner can update anything;
      // non-owner can ONLY add their own UID to collaboratorIds if shareToken matches
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (
          // Join via share link: user adds own UID to collaboratorIds
          request.resource.data.shareToken == resource.data.shareToken &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.participants == resource.data.participants &&
          request.auth.uid in request.resource.data.collaboratorIds &&
          !(request.auth.uid in resource.data.collaboratorIds)
        )
      );

      // Delete: owner only
      allow delete: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaboratorIds
        );
      }

      match /payments/{paymentId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaboratorIds
        );
      }

      match /members/{memberId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaboratorIds
        );
        allow write: if request.auth != null && (
          request.auth.uid == memberId ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid
        );
      }
    }
  }
}
